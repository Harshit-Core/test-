generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  REJECTED
  OFFER
}

enum JobSource {
  ADZUNA
  REMOTEOK
  MANUAL
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  role          Role            @default(USER)
  knownSkills   String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  savedStacks   SavedStack[]
  applications  Application[]
}

model Stack {
  id            String          @id @default(uuid())
  name          String          @unique
  description   String
  components    String[]
  tags          String[]
  useCase       String
  teamSize      String
  budget        String
  learningCurve String
  embedding     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  savedBy       SavedStack[]
}

model Job {
  id            String          @id @default(uuid())
  title         String
  company       String
  description   String
  location      String
  duration      String?
  isPaid        Boolean         @default(true)
  isRemote      Boolean         @default(false)
  tags          String[]
  source        JobSource
  externalUrl   String          @unique
  postedDate    DateTime
  expiryDate    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  applications  Application[]
  
  @@index([source])
  @@index([postedDate])
}

model SavedStack {
  id            String          @id @default(uuid())
  userId        String
  stackId       String
  notes         String?
  createdAt     DateTime        @default(now())
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stack         Stack           @relation(fields: [stackId], references: [id], onDelete: Cascade)
  
  @@unique([userId, stackId])
}

model Application {
  id            String              @id @default(uuid())
  userId        String
  jobId         String
  status        ApplicationStatus   @default(SAVED)
  notes         String?
  appliedDate   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@unique([userId, jobId])
}
